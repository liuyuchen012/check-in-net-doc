<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgoraIn.Mobile.Pages.WebFunctionsPage"
             Title="更多功能"
             BackgroundColor="#f5f7fa">
    <Grid RowDefinitions="Auto,*" Padding="16,12">
        <Label Grid.Row="0" Text="以下为网页端功能，App 内直接打开（已自动登录，与电脑端同一套界面）"
               FontSize="12" TextColor="#8a94a6" />

        <ScrollView Grid.Row="1" Margin="0,8,0,0">
            <CollectionView x:Name="FuncList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#e3e8ef" StrokeShape="RoundRectangle 10" Padding="14" Margin="0,0,0,6"
                                BackgroundColor="White">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding Icon}" FontSize="20" VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="2" HorizontalOptions="FillAndExpand">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="{Binding Desc}" FontSize="11" TextColor="#a5adba" />
                                </VerticalStackLayout>
                                <Label Text="›" FontSize="20" TextColor="#c0c4cc" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </Grid>
</ContentPage>
