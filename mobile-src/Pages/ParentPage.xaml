<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgoraIn.Mobile.Pages.ParentPage"
             Title="家长中心"
             BackgroundColor="#f5f7fa">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,12">
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Entry x:Name="InviteEntry" Placeholder="输入孩子的绑定邀请码" HorizontalOptions="FillAndExpand" />
            <Button Text="绑定" BackgroundColor="#4285f4" TextColor="White" CornerRadius="8"
                    Clicked="OnBindClicked" />
        </HorizontalStackLayout>

        <Label Grid.Row="1" x:Name="StatusLabel" Text="" FontSize="12" TextColor="#e6a23c" Margin="0,8,0,0" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="10">
                <Label Text="我的孩子" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0" />
                <CollectionView x:Name="ChildrenList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#e3e8ef" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,4">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding SubInfo}" FontSize="12" TextColor="#8a94a6"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="📈 成绩查询" FontSize="12" Padding="10,4"
                                                BackgroundColor="#e8f0fe" TextColor="#4285f4" CornerRadius="8"
                                                Clicked="OnScoresClicked" CommandParameter="{Binding .}" />
                                        <Button Text="💬 与老师对话" FontSize="12" Padding="10,4"
                                                BackgroundColor="#e8f0fe" TextColor="#4285f4" CornerRadius="8"
                                                Clicked="OnChatClicked" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="📚 学习资源" FontSize="12" Padding="10,4"
                                                BackgroundColor="#f1f3f4" TextColor="#5b6673" CornerRadius="8"
                                                Clicked="OnResourcesClicked" CommandParameter="{Binding .}" />
                                        <Button Text="🧹 值日安排" FontSize="12" Padding="10,4"
                                                BackgroundColor="#f1f3f4" TextColor="#5b6673" CornerRadius="8"
                                                Clicked="OnDutyClicked" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="班级公告" FontSize="16" FontAttributes="Bold" Margin="0,12,0,0" />
                <CollectionView x:Name="NoticesList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#e3e8ef" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,4">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding Content}" FontSize="12" TextColor="#5b6673" />
                                    <Label Text="{Binding CreatedAtText}" FontSize="11" TextColor="#a5adba" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="3" Text="刷新" BackgroundColor="#e8f0fe" TextColor="#4285f4" CornerRadius="8"
                Margin="0,10,0,0" Clicked="OnRefreshClicked" />
    </Grid>
</ContentPage>
