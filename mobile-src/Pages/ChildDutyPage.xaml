<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgoraIn.Mobile.Pages.ChildDutyPage"
             Title="值日安排"
             BackgroundColor="#f5f7fa">
    <Grid RowDefinitions="Auto,*" Padding="16,12">
        <Border Grid.Row="0" BackgroundColor="White" StrokeThickness="0"
                StrokeShape="RoundRectangle 12" Padding="16">
            <VerticalStackLayout Spacing="6">
                <Label x:Name="TitleLabel" Text="值日完成情况" FontSize="15" FontAttributes="Bold" />
                <Label x:Name="RateLabel" Text="—" FontSize="26" FontAttributes="Bold" TextColor="#4285f4" />
                <Label x:Name="CountLabel" Text="" FontSize="12" TextColor="#8a94a6" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" Margin="0,10,0,0">
            <VerticalStackLayout Spacing="8">
                <CollectionView x:Name="RecordList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#e3e8ef" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,4"
                                    BackgroundColor="White">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Mark}" FontSize="18" VerticalOptions="Center" />
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="FillAndExpand">
                                        <Label Text="{Binding PostName}" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding SubInfo}" FontSize="11" TextColor="#a5adba" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label x:Name="EmptyLabel" Text="" FontSize="12" TextColor="#8a94a6" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
