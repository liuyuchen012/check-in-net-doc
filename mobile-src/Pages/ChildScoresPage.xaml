        <Label Grid.Row="0" x:Name="StatusLabel" Text="加载中…" FontSize="13" TextColor="#8a94a6" Margin="0,0,0,8" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ScoreList" Spacing="10" />
        </ScrollView>
    </Grid>
</ContentPage>
