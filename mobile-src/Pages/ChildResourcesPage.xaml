<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgoraIn.Mobile.Pages.ChildResourcesPage"
             Title="学习资源"
             BackgroundColor="#f5f7fa">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12">
        <Label Grid.Row="0" x:Name="HintLabel" Text="老师下发的学习资料（点击下载/打开）"
               FontSize="12" TextColor="#8a94a6" />

        <ScrollView Grid.Row="1" Margin="0,8,0,0">
            <VerticalStackLayout Spacing="10">
                <CollectionView x:Name="ResourceList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#e3e8ef" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,4"
                                    BackgroundColor="White">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Icon}" FontSize="18" VerticalOptions="Center" />
                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding SubInfo}" FontSize="11" TextColor="#a5adba" />
                                    <Button Text="下载 / 打开" FontSize="12" Padding="10,4"
                                            BackgroundColor="#e8f0fe" TextColor="#4285f4" CornerRadius="8"
                                            HorizontalOptions="Start" Clicked="OnOpenClicked"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label x:Name="EmptyLabel" Text="" FontSize="12" TextColor="#8a94a6" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="刷新" BackgroundColor="#e8f0fe" TextColor="#4285f4" CornerRadius="8"
                Margin="0,10,0,0" Clicked="OnRefreshClicked" />
    </Grid>
</ContentPage>
