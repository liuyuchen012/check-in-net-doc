<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgoraIn.Mobile.Pages.ChatPage"
             BackgroundColor="#f5f7fa">
    <Grid RowDefinitions="*,Auto,Auto" Padding="12,8">
        <ScrollView Grid.Row="0" x:Name="MsgScroll">
            <VerticalStackLayout x:Name="MsgList" Spacing="6" Padding="4,10" />
        </ScrollView>
        <Entry Grid.Row="1" x:Name="InputEntry" Placeholder="给老师留言…" Completed="OnSendClicked" />
        <Button Grid.Row="2" Text="发送" BackgroundColor="#4285f4" TextColor="White" CornerRadius="8"
                Margin="0,8,0,0" Clicked="OnSendClicked" />
    </Grid>
</ContentPage>
